# Anthropic
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-6

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Database
# Локально: sqlite:///job_hunt.db
# Railway (с Volume смонтированным в /data): sqlite:////data/job_hunt.db
DATABASE_URL=sqlite:///job_hunt.db

# Scheduler intervals (hours)
SCOUT_INTERVAL_HOURS=6
LINKEDIN_INTERVAL_HOURS=12

# Jobindex scraper
JOBINDEX_RSS_URL=https://www.jobindex.dk/jobsoegning.rss
JOBINDEX_KEYWORDS=Java developer,Go developer,Golang,Node.js backend,Spring Boot,Fullstack developer,Backend engineer,Softwareudvikler
JOBINDEX_LOCATION=

# LinkedIn (cookie auth — предпочтительно)
LINKEDIN_EMAIL=
LINKEDIN_PASSWORD=
LINKEDIN_COOKIE=
LINKEDIN_JSESSIONID=

# Resume (по умолчанию: resume.md в корне проекта)
# RESUME_PATH=/absolute/path/to/resume.md
